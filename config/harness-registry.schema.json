{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness-registry.schema.json",
  "title": "Harness Registry",
  "description": "Registry of agent-CLI harnesses, model providers, and their bindings. Three orthogonal axes keep this tractable: integration mechanism (native | native_3p | base_url_override | custom_provider_decl), wire protocol, and credential route. 'Adapter required' is DERIVED (provider protocols ∩ harness protocols = ∅), never stored per pair. Drivers in packages/eval/src/harness own argv construction; this file declares capability, identity, and verification metadata.",
  "type": "object",
  "required": ["schema_version", "providers", "provider_aliases", "protocol_aliases", "harnesses"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string" },
    "comment": { "type": "string" },
    "price_bands": { "type": "array", "items": { "type": "string" } },
    "protocol_aliases": {
      "description": "Raw protocol strings seen in harness configs -> canonical wire protocol (e.g. pi's 'openai-completions', codex wire_api 'chat').",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/wire_protocol" }
    },
    "provider_aliases": {
      "description": "Raw provider strings observed on the wire -> canonical provider id + credential route (e.g. Claude Code's 'firstParty', Hermes's 'openai-codex').",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provider_id"],
        "additionalProperties": false,
        "properties": {
          "provider_id": { "type": "string" },
          "credential_route": { "anyOf": [{ "$ref": "#/definitions/credential_route" }, { "type": "null" }] },
          "note": { "type": "string" }
        }
      }
    },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/provider" } },
    "adapters": {
      "description": "Protocol adapters: local gateways that translate between a harness's spoken protocol and a provider's served protocol. An adapter REALIZES the derived fourth tier; which pairs need one stays computed from protocol mismatch, never stored.",
      "type": "array",
      "items": { "$ref": "#/definitions/adapter" }
    },
    "probe_policy": {
      "type": "object",
      "required": ["serialize", "token_strategy"],
      "additionalProperties": false,
      "properties": {
        "serialize": { "type": "boolean" },
        "token_strategy": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "harnesses": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/harness" } }
  },
  "definitions": {
    "wire_protocol": {
      "enum": [
        "openai-chat",
        "openai-responses",
        "anthropic-messages",
        "google-generative-ai",
        "azure-openai",
        "bedrock-sigv4",
        "vertex-ai"
      ]
    },
    "credential_route": {
      "description": "How a call is authenticated and billed. Distinct from provider: Hermes reporting 'openai-codex' is provider=openai + route=codex_subscription.",
      "enum": ["api_key", "oauth_subscription", "codex_subscription", "broker_subscription", "cloud_iam", "local_none"]
    },
    "mechanism": {
      "description": "Integration tiers 1-3; tier 4 (adapter) is derived from protocol mismatch and never stored.",
      "enum": ["native", "native_3p", "base_url_override", "custom_provider_decl"]
    },
    "attribution_method": {
      "enum": ["structured_json", "structured_jsonl", "stdout_banner", "log_scrape_windowed", "usage_file"]
    },
    "credential_option": {
      "type": "object",
      "required": ["route", "interactive"],
      "additionalProperties": false,
      "properties": {
        "route": { "$ref": "#/definitions/credential_route" },
        "env_vars": { "type": "array", "items": { "type": "string" } },
        "setup_command": { "type": "string" },
        "interactive": {
          "type": "boolean",
          "description": "true => needs a TTY/browser flow; a UI cannot silently compose env vars for it"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "display_name", "kind", "protocols_served", "credentials"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string" },
        "kind": { "enum": ["first_party", "broker", "aggregator", "cloud_platform", "local_runtime"] },
        "protocols_served": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/wire_protocol" } },
        "first_party_vendor": {
          "type": ["string", "null"],
          "description": "Who trained the weights, when fixed. null for brokers/aggregators — vendor is per-model there."
        },
        "credentials": { "type": "array", "items": { "$ref": "#/definitions/credential_option" } },
        "adapter_hints": {
          "description": "Per-adapter routing hints, keyed by adapter id (e.g. litellm model_prefix 'azure/', required params, auth options). Free-form per adapter; instances (endpoints, keys) stay in local-only artifacts, never here.",
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["id", "display_name", "kind", "serves_protocols", "install", "run", "security"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "display_name": { "type": "string" },
        "kind": { "enum": ["local_proxy"] },
        "serves_protocols": {
          "description": "Inbound protocols the adapter can accept — must cover what a harness speaks for that harness to route through it.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/wire_protocol" }
        },
        "install": {
          "type": "object",
          "required": ["recommended_route", "routes"],
          "additionalProperties": false,
          "properties": {
            "recommended_route": { "type": "string" },
            "routes": { "type": "array", "items": { "$ref": "#/definitions/install_route" } }
          }
        },
        "run": {
          "type": "object",
          "required": ["health_path", "default_port", "config_artifact"],
          "additionalProperties": false,
          "properties": {
            "health_path": { "type": "string" },
            "default_port": { "type": "integer" },
            "config_artifact": { "type": "string", "description": "Repo-relative LOCAL-ONLY path (gitignored artifacts) for the generated config — endpoints and keys are machine-local, never tracked" },
            "targets_artifact": { "type": "string", "description": "Repo-relative LOCAL-ONLY path holding the user's adapter targets (provider/model/api_base)" }
          }
        },
        "security": {
          "type": "object",
          "required": ["min_safe_version", "advisory"],
          "additionalProperties": false,
          "properties": {
            "min_safe_version": { "type": "string" },
            "blocked_versions": { "type": "array", "items": { "type": "string" } },
            "advisory": { "type": "string" }
          }
        },
        "attribution_rule": {
          "type": "string",
          "description": "How probe attribution changes behind this adapter (e.g. wire provider claims are meaningless; verify on model id instead)"
        },
        "quirks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "model": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "family": { "type": "string" },
        "vendor": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "tier": { "type": "string" },
        "price_band": { "type": ["string", "null"] },
        "price_usd_per_mtok": {
          "anyOf": [
            {
              "type": "object",
              "required": ["input", "output"],
              "additionalProperties": false,
              "properties": { "input": { "type": "number" }, "output": { "type": "number" } }
            },
            { "type": "null" }
          ]
        },
        "native_vision": { "type": ["boolean", "null"] },
        "effort_levels": { "type": "array", "items": { "type": "string" } },
        "context_k": { "type": ["number", "null"] },
        "release": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "protocol_spoken": {
      "type": "object",
      "required": ["protocol", "verified"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/definitions/wire_protocol" },
        "via": { "type": "string" },
        "verified": {
          "type": "boolean",
          "description": "true only when observed on a live run; docs-only claims stay false"
        }
      }
    },
    "provider_support": {
      "type": "object",
      "required": ["native"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "array", "items": { "type": "string" } },
        "native_note": { "type": "string" },
        "native_3p": { "type": "array", "items": { "type": "string" } },
        "byok": {
          "type": "object",
          "required": ["mechanism", "config_surface", "protocols"],
          "additionalProperties": false,
          "properties": {
            "mechanism": { "$ref": "#/definitions/mechanism" },
            "config_surface": { "type": "string" },
            "protocols": { "type": "array", "items": { "$ref": "#/definitions/wire_protocol" } },
            "constraints": { "type": "object" },
            "example": { "type": "string" }
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["method", "observed_by_driver", "provider_source", "model_source"],
      "additionalProperties": false,
      "properties": {
        "method": { "$ref": "#/definitions/attribution_method" },
        "observed_by_driver": {
          "type": "boolean",
          "description": "Whether the eval driver/probe actually extracts observed attribution on this path (vs. reporting registry-declared values)"
        },
        "provider_source": { "enum": ["wire", "inferred_from_binding", "declared"] },
        "model_source": { "enum": ["wire", "inferred_from_binding", "declared"] },
        "extraction": { "type": "object", "description": "Method-specific: json paths, stdout regexes, log path + windowing, usage-file flag" },
        "raw_provider_examples": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "probe_spec": {
      "type": "object",
      "required": ["timeout_ms"],
      "additionalProperties": false,
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1000 },
        "observed_latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
        },
        "retries": { "type": "integer", "minimum": 0 },
        "warmup_after_install": { "type": "boolean" }
      }
    },
    "install_route": {
      "type": "object",
      "required": ["id", "verified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string" },
        "update_command": { "type": "string" },
        "verified": { "type": "boolean", "description": "true only if exercised live; docs-only routes stay false" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["args"],
      "additionalProperties": false,
      "properties": {
        "args": { "type": "array", "items": { "type": "string" } },
        "prefer_family": { "type": "string" },
        "prefer_suffix": { "type": "string" }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "id",
        "name",
        "binary",
        "provider",
        "credential_route",
        "provider_label",
        "auth",
        "multimodal",
        "roles",
        "default_model",
        "default_effort",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "binary": { "type": "string" },
        "binary_candidates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Absolute paths (~ allowed) tried before PATH lookup — install scripts often wire PATH for interactive shells only"
        },
        "provider": { "type": "string", "description": "Canonical provider id (must exist in providers[])" },
        "credential_route": { "$ref": "#/definitions/credential_route" },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env_passthrough": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Env vars deliberately passed to this harness's subprocess despite the default strip-list (explicit API-key billing, never silent)"
            },
            "note": { "type": "string" }
          }
        },
        "provider_label": { "type": "string" },
        "auth": { "type": "string" },
        "maintainer": { "type": "string" },
        "docs_url": { "type": "string" },
        "multimodal": { "type": "boolean" },
        "vision_note": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "default_model": { "type": "string" },
        "default_effort": { "type": "string" },
        "effort_mechanism": { "type": ["string", "null"] },
        "discovery": { "anyOf": [{ "$ref": "#/definitions/discovery" }, { "type": "null" }] },
        "catalog_source": { "type": "string" },
        "catalog_as_of": { "type": "string" },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/model" } },
        "protocols_spoken": { "type": "array", "items": { "$ref": "#/definitions/protocol_spoken" } },
        "provider_support": { "$ref": "#/definitions/provider_support" },
        "attribution": { "$ref": "#/definitions/attribution" },
        "probe": { "$ref": "#/definitions/probe_spec" },
        "install": {
          "type": "object",
          "required": ["recommended_route", "routes"],
          "additionalProperties": false,
          "properties": {
            "recommended_route": { "type": "string" },
            "routes": { "type": "array", "items": { "$ref": "#/definitions/install_route" } }
          }
        },
        "version": {
          "type": "object",
          "required": ["scheme"],
          "additionalProperties": false,
          "properties": {
            "scheme": { "enum": ["semver", "date_tag", "commit_sha"] },
            "note": { "type": "string" }
          }
        },
        "quirks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
