# Ownership for the files that define what a green check means.
#
# GitHub reads only the FIRST CODEOWNERS file it finds (.github/ before the
# repository root), so every rule must live here; a second file elsewhere is
# silently inert.
#
# Every path below can silence the gate if edited without review. On a
# pull_request event GitHub runs the workflow definition from the HEAD ref, so a
# pull request that deletes the verify-fixtures step, the clean-tree assertion,
# or the whole workflow-safety job produces a green `gate` on its own terms.
# CODEOWNERS plus "Require review from Code Owners" is what makes these guards
# mechanical rather than advisory, so both must be enabled at the same moment
# the required checks are turned on.

# CI definition, the gate scripts, and the guard rules.
/.github/                @jdehorty

# What the evaluator asserts, and what counts as a pass.
/eval.config.json        @jdehorty
/evaluation/cases/       @jdehorty
/evaluation/fixtures/    @jdehorty
/evaluation/schemas/     @jdehorty

# The matcher registry and the scorecard assembly.
/packages/eval/src/evaluation/   @jdehorty

# The commands the gate actually invokes. verifyFixtures.ts is the check that
# makes the gate two-directional, so leaving it unowned would let a pull request
# weaken the one guard that detects a matcher degrading to always-pass; the same
# argument applies to the scorer, the manifest validator, and the hygiene checks.
/packages/eval/src/commands/verifyFixtures.ts @jdehorty
/packages/eval/src/commands/score.ts          @jdehorty
/packages/eval/src/commands/validate.ts       @jdehorty
/packages/eval/src/commands/check.ts          @jdehorty

# The tests are guards too: gateContract.test.ts pins the threshold floor, the
# registry/schema agreement, and the inventory of matchers no fixture drives to
# fail. All three are trivially silenced by editing the test.
/packages/eval/tests/            @jdehorty

# The secret scanner and its configuration.
/.gitleaks.toml                        @jdehorty
/optimization/scripts/check-secrets.sh @jdehorty

# The harness drivers execute credentialed CLIs, and the lockfile decides what
# npm actually installs on every runner.
/packages/eval/src/harness/ @jdehorty
/package-lock.json          @jdehorty
